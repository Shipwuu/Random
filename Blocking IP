-- PERBAIKAN METATABLE HOOK (SANGAT AGRESIF)
local IP_LAPTOP = "192.168.1.6" -- Sesuai log PowerShell Anda

print("[IYAI-PATCH] Memulai injeksi jaringan tingkat tinggi...")

-- Ambil fungsi request asli
local old_request
old_request = hookfunction(syn and syn.request or http_request or request, function(options)
    if options and type(options) == "table" and type(options.Url) == "string" then
        -- Paksa ganti semua kata localhost atau 127.0.0.1 kapan pun skrip utama memanggilnya
        if string.find(options.Url, "localhost") or string.find(options.Url, "127.0.0.1") then
            options.Url = string.gsub(options.Url, "localhost", IP_LAPTOP)
            options.Url = string.gsub(options.Url, "127.0.0.1", IP_LAPTOP)
            warn("[IYAI-FORCE] Berhasil membelokkan skrip utama ke: " .. options.Url)
        end
    end
    return old_request(options)
end)

print("[SUCCESS] Proteksi Jaringan Selesai. Silakan buka menu ;ai dan klik Connect.")

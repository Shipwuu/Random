local savedProximityData = {}  -- To store original HoldDurations and paths
local isInstant = false  -- To track if instant proximity is enabled or not

-- Function to collect all ProximityPrompt objects and save their HoldDurations
local function collectProximityPrompts()
    -- Iterate through all descendants of the workspace
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            -- Save the original HoldDuration and the object's path
            table.insert(savedProximityData, {
                path = obj:GetFullName(),  -- Save the full object path
                holdDuration = obj.HoldDuration,  -- Save the original HoldDuration
                object = obj  -- Reference to the object itself
            })
        end
    end
end

-- Function to create and show the notification
local function showNotification(message)
    -- Create the notification GUI
    local player = game.Players.LocalPlayer
    local screenGui = player:WaitForChild("PlayerGui"):FindFirstChild("NotificationGui")
    
    if not screenGui then
        screenGui = Instance.new("ScreenGui")
        screenGui.Name = "NotificationGui"
        screenGui.Parent = player.PlayerGui

        -- Create the text label for the notification
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(0, 300, 0, 50)
        label.Position = UDim2.new(0.5, -150, 0.1, 0)
        label.BackgroundTransparency = 0.5
        label.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
        label.TextSize = 20
        label.Text = message
        label.Parent = screenGui

        -- Fade out the notification after 2 seconds
        wait(2)

        -- Fade out the notification by tweening its transparency
        game:GetService("TweenService"):Create(label, TweenInfo.new(1), {TextTransparency = 1, BackgroundTransparency = 1}):Play()
        wait(1)  -- Wait for the tween to finish
        label:Destroy()  -- Remove the label after the tween
    end
end

-- Function to toggle between instant proximity and original HoldDuration
local function toggleProximity()
    isInstant = not isInstant

    -- If instant proximity is enabled
    if isInstant then
        for _, data in pairs(savedProximityData) do
            -- Set all HoldDurations to 0 for instant proximity
            data.object.HoldDuration = 0
        end
        -- Show notification that instant proximity is ON
        showNotification("Instant Proximity: ON")
    else
        -- Restore the original HoldDurations
        for _, data in pairs(savedProximityData) do
            data.object.HoldDuration = data.holdDuration
        end
        -- Show notification that instant proximity is OFF
        showNotification("Instant Proximity: OFF")
    end
end

-- Collect all proximity prompts when the script starts
collectProximityPrompts()

-- Listen for a key press to toggle proximity
game:GetService("UserInputService").InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == Enum.KeyCode.P then
        toggleProximity()
    end
end)
